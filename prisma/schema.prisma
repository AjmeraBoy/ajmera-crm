generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// AJMERA FASHION LIMITED - IN-HOUSE CRM
// Departments: ONLINE (India B2B) | EXPORT (International B2B)
// ============================================================

// ---------------- AUTH & ORGANIZATION ----------------

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  role            String // SUPER_ADMIN | ADMIN | MANAGER | TEAM_LEADER | EXECUTIVE | ACCOUNTS | DISPATCH | SUPPORT | VIEWER
  department      String? // ONLINE | EXPORT | null = all departments
  phone           String?
  languages       String? // comma separated e.g. "Hindi,English"
  dailyCallTarget Int      @default(60)
  sipExtension    String?  // SIP extension for the dialer (e.g. 1001)
  isActive        Boolean  @default(true)
  teamId          String?
  team            Team?    @relation("TeamMembership", fields: [teamId], references: [id])
  ledTeams        Team[]   @relation("TeamLeader")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions         Session[]
  leads            Lead[]                 @relation("LeadOwner")
  leadsCreated     Lead[]                 @relation("LeadCreator")
  activities       Activity[]
  followups        FollowUp[]             @relation("FollowUpOwner")
  followupsCreated FollowUp[]             @relation("FollowUpCreator")
  callLogs         CallLog[]
  conversations    WhatsAppConversation[] @relation("ChatOwner")
  messages         WhatsAppMessage[]
  targets          Target[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  ticketsAssigned  SupportTicket[]        @relation("TicketAssignee")
  meetings         Meeting[]
  documents        Document[]
  quotations       Quotation[]
  orders           SalesOrder[]
  payments         Payment[]
  campaigns        Campaign[]
  ticketComments   TicketComment[]
}

model Team {
  id         String   @id @default(cuid())
  name       String
  department String // ONLINE | EXPORT
  leaderId   String?
  leader     User?    @relation("TeamLeader", fields: [leaderId], references: [id])
  members    User[]   @relation("TeamMembership")
  createdAt  DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------------- DYNAMIC MASTER DATA (fully admin-configurable) ----------------

model MasterItem {
  id        String   @id @default(cuid())
  type      String // disposition | sub_disposition | lead_source | pipeline_stage | country | state | business_type | product_category | courier | ticket_type | payment_mode | language | conversation_label
  label     String
  value     String?
  parentId  String?
  parent    MasterItem?  @relation("MasterTree", fields: [parentId], references: [id])
  children  MasterItem[] @relation("MasterTree")
  dept      String   @default("ALL") // ONLINE | EXPORT | ALL
  extra     String? // JSON: {"color":"#22c55e","showCallback":true,"showEstimated":true,"showPayment":true,"showFollowUp":true,"icon":"..."}
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  dispositionLeads    Lead[]     @relation("LeadDisposition")
  subDispositionLeads Lead[]     @relation("LeadSubDisposition")
  sourceLeads         Lead[]     @relation("LeadSource")
  stageLeads          Lead[]     @relation("LeadStage")
  businessTypeLeads   Lead[]     @relation("LeadBusinessType")
  stateLeads          Lead[]     @relation("LeadState")
  countryLeads        Lead[]     @relation("LeadCountry")
  products            Product[]
}

// ---------------- LEADS & PIPELINE ----------------

model Lead {
  id               String    @id @default(cuid())
  leadCode         String    @unique
  department       String // ONLINE | EXPORT
  customerName     String
  companyName      String?
  mobile           String
  whatsapp         String?
  email            String?
  city             String?
  stateId          String?
  state            MasterItem? @relation("LeadState", fields: [stateId], references: [id])
  countryId        String?
  country          MasterItem? @relation("LeadCountry", fields: [countryId], references: [id])
  businessTypeId   String?
  businessType     MasterItem? @relation("LeadBusinessType", fields: [businessTypeId], references: [id])
  productInterest  String?
  requirementNotes String?
  monthlyVolume    Int?
  budget           Int?
  sourceId         String?
  source           MasterItem? @relation("LeadSource", fields: [sourceId], references: [id])
  visitDate        DateTime?
  visitTime        String?
  assignedToId     String?
  assignedTo       User?       @relation("LeadOwner", fields: [assignedToId], references: [id])
  createdById      String?
  createdBy        User?       @relation("LeadCreator", fields: [createdById], references: [id])
  stageId          String?
  stage            MasterItem? @relation("LeadStage", fields: [stageId], references: [id])
  dispositionId    String?
  disposition      MasterItem? @relation("LeadDisposition", fields: [dispositionId], references: [id])
  subDispositionId String?
  subDisposition   MasterItem? @relation("LeadSubDisposition", fields: [subDispositionId], references: [id])
  priority         String? // HIGH | MEDIUM | LOW
  estimatedValue   Int?
  notes            String?
  lastFollowUpAt   DateTime?
  nextFollowUpAt   DateTime?
  lastContactAt    DateTime?
  // WhatsApp communication state
  waStatus         String?   // AVAILABLE | NOT_AVAILABLE | UNKNOWN
  optInStatus      String    @default("UNKNOWN") // OPTED_IN | NOT_OPTED_IN | UNKNOWN
  optInAt          DateTime?
  optInSource      String?   // INBOUND_MESSAGE | MANUAL | API
  lastWaMessage    String?   // last WhatsApp message preview
  lastWaMessageAt  DateTime?
  lastWaDirection  String?   // IN | OUT
  isSticky         Boolean   @default(false)
  stickySince      DateTime?
  status           String    @default("ACTIVE") // ACTIVE | CONVERTED | LOST
  customerType     String? // NEW | REPEAT
  campaignId       String?
  campaign         Campaign? @relation(fields: [campaignId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activities    Activity[]
  followups     FollowUp[]
  callLogs      CallLog[]
  conversations WhatsAppConversation[]
  quotations    Quotation[]
  orders        SalesOrder[]
  payments      Payment[]
  shipments     Shipment[]
  tickets       SupportTicket[]
  meetings      Meeting[]
  documents     Document[]
}

// Unified customer timeline entry
model Activity {
  id          String   @id @default(cuid())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  type        String // CALL | WHATSAPP | NOTE | DISPOSITION | STAGE | ASSIGNMENT | FOLLOWUP | QUOTATION | ORDER | PAYMENT | DISPATCH | TICKET | MEETING | DOCUMENT | AI_CALL | BROADCAST | SYSTEM | LOGIN | LEAD
  title       String
  description String?
  meta        String? // JSON
  createdAt   DateTime @default(now())
}

model FollowUp {
  id           String    @id @default(cuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation("FollowUpOwner", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?     @relation("FollowUpCreator", fields: [createdById], references: [id])
  dueAt        DateTime
  status       String    @default("PENDING") // PENDING | COMPLETED | RESCHEDULED | NO_RESPONSE | ESCALATED
  note         String?
  completedAt  DateTime?
  outcome      String?
  createdAt    DateTime  @default(now())
}

// ---------------- TELECALLING ----------------

model CallLog {
  id              String    @id @default(cuid())
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  direction       String    // INCOMING | OUTGOING
  status          String    // CONNECTED | NOT_CONNECTED | MISSED
  durationSec     Int       @default(0)
  recordingUrl    String?
  isVideo         Boolean   @default(false)
  channel         String    @default("CRM") // CRM | SIP | WHATSAPP | AI_REMINDER
  notes           String?
  dispositionId   String?
  // SIP / dialer lifecycle
  providerCallId  String?   // call id returned by SIP/dialer provider
  customerNumber  String?
  agentNumber     String?
  callStatus      String?   // QUEUED | RINGING | IN_PROGRESS | ON_HOLD | COMPLETED | FAILED | MISSED (live lifecycle)
  startAt         DateTime?
  answerAt        DateTime?
  endAt           DateTime?
  holdSec         Int       @default(0)
  transferedTo    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
}

// ---------------- WHATSAPP (WABA) ----------------

model WhatsAppConversation {
  id            String    @id @default(cuid())
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id])
  phone         String
  name          String?
  label         String?
  dept          String?
  ownerId       String?
  owner         User?     @relation("ChatOwner", fields: [ownerId], references: [id])
  unreadCount   Int       @default(0)
  lastMessage   String?
  lastMessageAt DateTime?
  lastInboundAt DateTime? // last customer inbound message — 24h session window anchor
  isPinned      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  messages      WhatsAppMessage[]
}

model WhatsAppMessage {
  id                String               @id @default(cuid())
  conversationId    String
  conversation      WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?                @relation(fields: [userId], references: [id])
  direction         String               // IN | OUT
  type              String               @default("TEXT") // TEXT | IMAGE | PDF | VOICE | VIDEO | TEMPLATE | PRODUCT | LOCATION
  body              String?
  mediaName         String?
  mediaUrl          String?
  templateId        String?
  status            String               @default("QUEUED") // QUEUED | SENT | DELIVERED | READ | FAILED
  isPrivate         Boolean              @default(false)
  campaignId        String?
  campaign          Campaign?            @relation(fields: [campaignId], references: [id])
  // Provider integration
  providerMessageId String?              // wamid from Alendei/WhatsApp
  requestId         String?              // unique CRM request id (idempotency across retries)
  templateName      String?
  templateVars      String?              // JSON array of resolved params
  errorCode         String?
  errorMessage      String?
  attempts          Int                  @default(0)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt

  @@index([providerMessageId])
  @@index([requestId])
}

model WhatsAppTemplate {
  id                 String    @id @default(cuid())
  name               String
  providerTemplateId String?   // template id on Alendei / Meta
  language           String    @default("en")
  category           String    @default("MARKETING") // MARKETING | UTILITY | AUTHENTICATION | SESSION
  status             String    @default("PENDING") // APPROVED | PENDING | REJECTED | DISABLED
  body               String
  headerType         String    @default("NONE") // NONE | TEXT | IMAGE | DOCUMENT | VIDEO
  headerText         String?
  footerText         String?
  buttons            String?   // JSON array
  variableCount      Int       @default(0)
  variables          String?   // JSON array of example params / labels
  dept               String?   // null = all
  isActive           Boolean   @default(true)
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
}

// ---------------- PRODUCT & CATALOG ----------------

model Product {
  id               String      @id @default(cuid())
  code             String      @unique
  name             String
  categoryId       String?
  category         MasterItem? @relation(fields: [categoryId], references: [id])
  sku              String?
  moq              Int         @default(1)
  price            Int         @default(0) // in ₹
  description      String?
  packagingDetails String?
  fabricDetails    String?
  images           String? // JSON array of image urls
  video            String?
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
}

// ---------------- SALES WORKFLOW: Quote → Order → Invoice → Payment → Dispatch ----------------

model Quotation {
  id          String    @id @default(cuid())
  quoteNo     String    @unique
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  department  String
  items       String // JSON: [{productId,name,qty,price}]
  subtotal    Int       @default(0)
  discount    Int       @default(0)
  total       Int       @default(0)
  status      String    @default("DRAFT") // DRAFT | SENT | VIEWED | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  validUntil  DateTime?
  notes       String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orders      SalesOrder[]
}

model SalesOrder {
  id            String     @id @default(cuid())
  orderNo       String     @unique
  leadId        String
  lead          Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quotationId   String?
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  department    String
  items         String // JSON
  total         Int        @default(0)
  paidAmount    Int        @default(0)
  paymentStatus String     @default("PENDING") // PENDING | PARTIAL | PAID
  customerType  String     @default("NEW") // NEW | REPEAT
  status        String     @default("CONFIRMED") // CONFIRMED | IN_PROCESS | DISPATCHED | DELIVERED | CANCELLED
  notes         String?
  createdById   String?
  createdBy     User?      @relation(fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  invoices      Invoice[]
  shipment      Shipment?
  payments      Payment[]
}

model Invoice {
  id         String     @id @default(cuid())
  invoiceNo  String     @unique
  orderId    String
  order      SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Int        @default(0)
  paidAmount Int        @default(0)
  status     String     @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE
  dueDate    DateTime?
  notes      String?
  createdAt  DateTime   @default(now())
  payments   Payment[]
}

model Payment {
  id          String      @id @default(cuid())
  receiptNo   String      @unique
  leadId      String?
  lead        Lead?       @relation(fields: [leadId], references: [id])
  orderId     String?
  order       SalesOrder? @relation(fields: [orderId], references: [id])
  invoiceId   String?
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id])
  department  String
  amount      Int
  mode        String      @default("BANK_TRANSFER") // CASH | UPI | BANK_TRANSFER | CHEQUE | CARD | OTHER
  reference   String?
  isAdvance   Boolean     @default(false)
  notes       String?
  paidAt      DateTime    @default(now())
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
}

model Shipment {
  id           String     @id @default(cuid())
  orderId      String     @unique
  order        SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?      @relation(fields: [leadId], references: [id])
  department   String
  stage        String     @default("PACKING") // PACKING | QC | DISPATCHED | IN_TRANSIT | DELIVERED
  courierName  String?
  awbNumber    String?
  trackingUrl  String?
  proofUrl     String?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ---------------- CUSTOMER SUPPORT ----------------

model SupportTicket {
  id           String    @id @default(cuid())
  ticketNo     String    @unique
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id])
  department   String
  type         String // Shipment Delay | Product Complaint | Damage Issue | Replacement Request | Payment Issue
  priority     String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  subject      String
  description  String?
  status       String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED | ESCALATED
  slaDueAt     DateTime?
  assignedToId String?
  assignedTo   User?     @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdById  String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  comments     TicketComment[]
}

model TicketComment {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
}

// ---------------- MARKETING & ENGAGEMENT ----------------

model Campaign {
  id          String    @id @default(cuid())
  name        String
  type        String    @default("OUTGOING") // INCOMING | OUTGOING | BROADCAST
  channel     String    @default("WHATSAPP") // WHATSAPP | CALL | SMS | EMAIL
  department  String?
  description String?
  startDate   DateTime?
  endDate     DateTime?
  budget      Int       @default(0)
  status      String    @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  conversions Int       @default(0)
  revenue     Int       @default(0)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  leads       Lead[]
  messages    WhatsAppMessage[]
}

model Meeting {
  id             String    @id @default(cuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title          String
  scheduledAt    DateTime
  executiveId    String?
  executive      User?     @relation(fields: [executiveId], references: [id])
  link           String?
  outcome        String? // COMPLETED | NO_SHOW | RESCHEDULED | INTERESTED | NOT_INTERESTED
  notes          String?
  followUpAction String?
  createdAt      DateTime  @default(now())
}

model Document {
  id           String    @id @default(cuid())
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id])
  name         String
  type         String    @default("OTHER") // QUOTATION | INVOICE | PACKING_LIST | SHIPPING | PRODUCT_PDF | AGREEMENT | OTHER
  url          String?
  version      Int       @default(1)
  expiryDate   DateTime?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
}

// ---------------- TARGETS, NOTIFICATIONS, AUDIT, SETTINGS ----------------

model Target {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  month  String // YYYY-MM
  amount Int    @default(0) // in ₹

  @@unique([userId, month])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String?
  type      String   @default("INFO") // INFO | LEAD | PAYMENT | SHIPMENT | TICKET | CALL | WHATSAPP | ALERT
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String?
  action    String
  entity    String?
  entityId  String?
  details   String? // JSON
  ip        String?
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------- COMMUNICATION INTEGRATION (WhatsApp / SIP / Webhooks) ----------------

/** Every inbound webhook payload is stored here. Idempotent processing via dedupeKey. */
model WebhookEvent {
  id               String    @id @default(cuid())
  eventId          String?   // provider event id if present
  dedupeKey        String    @unique // hash(provider+type+ids) — prevents duplicate processing
  provider         String    // WHATSAPP | VOICE
  eventType        String    // MESSAGE | MESSAGE_STATUS | CALL_EVENT | VERIFICATION | UNKNOWN
  waId             String?
  phoneNumber      String?
  leadId           String?
  payload          String    // raw JSON payload (archived for audit/debug)
  processingStatus String    @default("RECEIVED") // RECEIVED | PROCESSED | DUPLICATE | FAILED | UNRECOGNIZED
  error            String?
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  ip               String?

  @@index([provider, eventType])
  @@index([receivedAt])
}

/** Technical log of every outbound call to a communication provider. NEVER contains secrets. */
model ApiLog {
  id            String   @id @default(cuid())
  provider      String   // WHATSAPP_ALENDEI | SIP | INTERNAL
  endpoint      String
  method        String
  requestId     String?
  responseCode  Int?
  durationMs    Int?
  success       Boolean
  errorType     String?  // AUTH | RATE_LIMIT | VALIDATION | NOT_FOUND | SERVER | NETWORK | TIMEOUT | UNKNOWN
  errorMessage  String?  // technical detail (sanitized, secrets redacted)
  readableError String?  // user-friendly message shown in UI
  leadId        String?
  userId        String?
  attempt       Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([provider, createdAt])
  @@index([success])
}

/** Audit trail of every Alendei campaign/API message send attempt. */
model CampaignLog {
  id                String   @id @default(cuid())
  requestId         String   @unique
  campaignName      String
  destination       String
  templateName      String?
  leadId            String?
  userId            String?
  apiLogId          String?
  success           Boolean
  providerMessageId String?
  errorMessage      String?
  payload           String?  // sanitized request body (apiKey redacted)
  createdAt         DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

/** WHEN/THEN communication automation engine rules. */
model AutomationRule {
  id        String    @id @default(cuid())
  name      String
  trigger   String    // LEAD_CREATED | LEAD_ASSIGNED | LEAD_STATUS_CHANGED | FOLLOWUP_DUE | CALL_MISSED | CALL_COMPLETED | INBOUND_WHATSAPP | WHATSAPP_FAILED | MANUAL
  dept      String?   // null = all departments
  conditions String?  // JSON: [{field, op, value}]
  actions   String    // JSON array: [{type: SEND_WHATSAPP_TEMPLATE | CREATE_TASK | NOTIFY_AGENT | UPDATE_LEAD_FIELD, ...}]
  isActive  Boolean   @default(false)
  lastRunAt DateTime?
  runCount  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  logs      AutomationLog[]
}

model AutomationLog {
  id        String         @id @default(cuid())
  ruleId    String
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  leadId    String?
  trigger   String
  status    String         // SUCCESS | FAILED | SKIPPED
  detail    String?        // JSON summary of actions taken
  createdAt DateTime       @default(now())

  @@index([ruleId, createdAt])
  @@index([leadId])
}

/** Uploaded media assets. Files live on disk under uploads/, served via authenticated/signed URL. */
model FileAsset {
  id          String   @id @default(cuid())
  filename    String
  mime        String
  size        Int
  path        String   // disk path (relative)
  kind        String   @default("WHATSAPP_MEDIA") // WHATSAPP_MEDIA | RECORDING | DOCUMENT | OTHER
  createdById String?
  createdAt   DateTime @default(now())
}

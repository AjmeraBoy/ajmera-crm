# ---------- DATABASE ----------
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ---------- COMMUNICATION: WHATSAPP (Alendei / FlexiWaba) ----------
# API key priority: env > encrypted value saved in Settings UI. Replace the
# placeholder with the real client key WITHOUT any code change.
WHATSAPP_API_BASE_URL=https://autoapi.alendei.io
WHATSAPP_API_KEY=
WHATSAPP_BUSINESS_NUMBER=+912613547700

# ---------- COMMUNICATION: SIP / DIALER ----------
SIP_PROVIDER=
SIP_SERVER=
SIP_USERNAME=
SIP_PASSWORD=
SIP_PORT=5060
SIP_TRANSPORT=UDP
SIP_CALLER_ID=+912613547700

# ---------- COMMUNICATION: SECURITY ----------
# Required on every webhook call: /api/webhooks/whatsapp?secret=... or x-webhook-secret header
COMM_WEBHOOK_SECRET=3223a6e7d654b16307169fc66ca4bf61edab8edefd7d5bc0
# Shared secret between Next API and the socket relay service (internal only)
INTERNAL_EVENT_SECRET=5694f111b0ac0dea2e0a0b37a15cf8460f3780492864923c
# Master key for encrypting credentials at rest (AES-256-GCM) — rotate via env only
CONFIG_ENCRYPTION_KEY=be6f4af513fefe6d0fd47220e35d3af4498926d2ac4e8e7259c29f7689f633ee
# Public origin used to build absolute media URLs for Alendei to fetch
PUBLIC_BASE_URL=
